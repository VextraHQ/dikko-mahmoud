# Copy to .env.local. Nothing here is required to run the site locally.
# Details: docs/environment.md

# The public address of the site, without a trailing slash. Used for canonical
# links, share images, the sitemap and robots.txt. Leave empty on Vercel,
# which supplies its own address, unless the site uses a custom domain.
NEXT_PUBLIC_SITE_URL=

# Set by Vercel on its own; never set these by hand.
# VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL

# Not used yet. Added when email delivery and the CMS are approved
# (docs/integrations/email.md, docs/integrations/sanity.md):
# RESEND_API_KEY=
# ENQUIRY_TO_EMAIL=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=
# SANITY_API_READ_TOKEN=
# SANITY_REVALIDATE_SECRET=
